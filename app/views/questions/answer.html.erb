<% def answer(question)
  if question == "I am going to work"
    return "Great!"
  elsif question.end_with?("?")
    return "Silly question, get dressed and go to work!"
  else
    return "I don't care, get dressed and go to work!"
  end
end %>

<div class="card">
<h1>Stupid Coaching</h1>

  <div class="card-body student">
    <p class="text-input"><%= @question %></p>
    <p class = "text-author"><%= "- You" %></p>
  </div>

  <div class="card-body coach">
    <p class="text-input"><%= @answer = answer(@question) %></p>
    <p class = "text-author"><%= "- Your coach" %></p>
  </div>

</div>

<%= link_to "Ask a new question", ask_path %>
